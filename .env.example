# Copy to .env next to compose.yml and fill in. Never commit .env.

# ── Sign-in ──────────────────────────────────────────────────────────────────
# "discord" (default): only the Discord accounts in config.yml see the page.
# "off" is for your own machine only.
ACCESS_MODE=discord

# Your Discord application (https://discord.com/developers/applications → OAuth2),
# the same one Treasure uses. Add this exact Redirect there:
#   https://home.niijimasisters.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the sign-in cookie. Use the SAME value in every Niijima app, and you sign
# in once for all of them. Any long random string:  openssl rand -hex 32
SESSION_SECRET=
# The parent domain the sign-in cookie is shared on. Same value in every app.
# Needed for makoto.… and sae.… to see the sign-in made on home.…
SESSION_DOMAIN=niijimasisters.com
# The address you sign in at, without a trailing slash. makoto.… and sae.… send
# you here for the Discord step and back again.
PUBLIC_URL=https://home.niijimasisters.com

# ── Today: upcoming events from Niijima Calendar ─────────────────────────────
# Its address on the Docker network, and the token Calendar gives the homepage.
# Leave CALENDAR_URL empty to hide the events (the section says it's not set up).
CALENDAR_URL=http://niijima-calendar:3000
CALENDAR_TOKEN=

# ── Treasury: the money summary from Treasure ────────────────────────────────
# Its address on the Docker network, and the SUMMARY_TOKEN from Treasure's .env
# (the same value in both files).
TREASURE_URL=http://niijima-treasure:3000
SUMMARY_TOKEN=

# ── Server setup (used by compose.yml) ───────────────────────────────────────
# The three hosts Traefik routes to the app.
APP_HOST=home.niijimasisters.com
MAKOTO_HOST=makoto.niijimasisters.com
SAE_HOST=sae.niijimasisters.com
# The Docker network Traefik listens on, and its entrypoint name.
TRAEFIK_NETWORK=zipline_default
TRAEFIK_ENTRYPOINT=web
# User and group the app runs as (id -u, id -g); they own ./data.
PUID=1000
PGID=1000
